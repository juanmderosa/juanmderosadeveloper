---
import { Image } from "astro:assets";
import fotoperfil from "../assets/images/fotoperfil.png";
import ButtonLink from "../ui/ButtonLink.astro";

const { t } = Astro.props;
---

<section
  class="container about-container"
  id="sobremi">
  <article class="about-image-card glass-card">
    <Image
      src={fotoperfil}
      width={360}
      height={480}
      alt={t.about.imageAlt}
      class="about-image"
      loading="eager"
    />
    <div class="image-caption">
      <span class="caption-dot"></span>
      <span>{t.about.caption}</span>
    </div>
  </article>

  <article class="about-copy">
    <p class="section-kicker">{t.about.kicker}</p>
    <h2>{t.about.title}</h2>
    <h3>{t.about.role}</h3>
    {t.about.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
    <ButtonLink
      href={t.lang === "es"
        ? "/CV%20-%20Juan%20Mart%C3%ADn%20De%20Rosa.pdf"
        : "/CV%20-%20Juan%20Mart%C3%ADn%20De%20Rosa%20-%20English.pdf"}
      text={t.about.cv}
      isDownloadable={true}
    />
  </article>
</section>

<style>
  .about-container {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 4rem;
  }

  .about-image-card {
    min-height: 31rem;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: end;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(109, 84, 207, 0.55),
        transparent 48%
      ),
      linear-gradient(180deg, rgba(203, 190, 255, 0.08), rgba(38, 37, 51, 0.62));
  }

  .about-image {
    width: min(82%, 24rem);
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.08);
  }

  .image-caption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    background: rgba(15, 14, 23, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }

  .image-caption span {
    font-size: 0.72rem;
    color: var(--on-surface);
  }

  .caption-dot {
    width: 0.45rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--primary);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .about-copy h2 {
    margin-bottom: 0;
  }

  .about-copy h3 {
    color: var(--primary);
    font-size: 1rem;
    font-family: "JetBrains Mono", monospace;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .about-copy .button {
    margin-top: 1rem;
  }

  @media screen and (max-width: 900px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-image-card {
      min-height: 25rem;
    }
  }
</style>
