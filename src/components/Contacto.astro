---
import githubIcon from "../assets/logos/github.png";
import linkedinIcon from "../assets/logos/linkedin.png";
import LinkIcon from "../ui/LinkIcon.astro";
import WaIcon from "../assets/logos/whatsapp.png";
import EmailIcon from "../assets/logos/email.png";
import Form from "../ui/Form.astro";
import { Image } from "astro:assets";

const { t } = Astro.props;
---

<section
  class="container contacto-container"
  id="contactame">
  <article class="contacto-copy">
    <p class="section-kicker">{t.contact.kicker}</p>
    <h2>{t.contact.title}</h2>
    <p>{t.contact.description}</p>

    <div class="contacto-info-container">
      <div class="contacto-data-container">
        <span class="contact-icon">
          <Image
            src={WaIcon}
            alt={"Whatsapp Icon"}
            width={24}
            height={24}
          /></span
        >
        <div>
          <p>{t.contact.phone}</p>
          <a
            href="https://api.whatsapp.com/send/?phone=5491154632571&text&type=phone_number&app_absent=0"
            target="_blank"
            rel="noopener noreferrer"
            >+54 9 11 5463-2571</a
          >
        </div>
      </div>
      <div class="contacto-data-container">
        <span class="contact-icon">
          <Image
            src={EmailIcon}
            alt={"Email Icon"}
            width={24}
            height={24}
          /></span
        >
        <div>
          <p>{t.contact.email}</p>
          <a href="mailto:juanmderosa@gmail.com">juanmderosa@gmail.com</a>
        </div>
      </div>
      <div
        class="contacto-links-container"
        aria-label={t.contact.socialsAria}>
        <LinkIcon
          icon={githubIcon}
          href="https://github.com/juanmderosa"
          width={24}
          height={24}
          alt="Github Icon"
        />
        <LinkIcon
          icon={linkedinIcon}
          href="https://www.linkedin.com/in/juanmderosa/"
          width={24}
          height={24}
          alt="Linkedin Icon"
        />
      </div>
    </div>
  </article>

  <article class="contacto-form-container glass-card">
    <Form t={t} />
  </article>
</section>

<style>
  .contacto-container {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1fr);
    align-items: start;
    gap: 4rem;
  }

  .contacto-copy h2 {
    margin-bottom: 1rem;
  }

  .contacto-copy > p:not(.section-kicker) {
    max-width: 34rem;
  }

  .contacto-info-container {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .contacto-links-container {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .contacto-data-container {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .contact-icon {
    width: 2.4rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: rgba(109, 84, 207, 0.16);
    border: 1px solid rgba(203, 190, 255, 0.45);
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    transition: all 300ms ease;
    &:hover {
      transform: translateY(-2px);
      border-color: rgba(109, 84, 207, 0.16);
      background: rgba(203, 190, 255, 0.45);
    }
  }

  .contacto-data-container p {
    color: var(--on-surface);
    font-weight: 700;
    line-height: 1.2;
  }

  .contacto-data-container a {
    color: var(--on-surface-variant);
  }

  .contacto-form-container {
    padding: 0.5rem;
  }

  @media screen and (max-width: 900px) {
    .contacto-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
