---
import { ProyectosSlider } from "../ui/ProyectosSlider";
import { getCollection } from "astro:content";

const { t } = Astro.props;
const projects = (await getCollection("projects")).map((p) => {
  const copy = t.projects.items[p.data.id];
  return {
    ...p.data,
    title: copy?.title ?? p.data.title,
    description: copy?.description ?? p.data.description,
  };
});
---

<section
  class="container"
  id="proyectos">
  <div class="projects-heading">
    <p class="section-kicker">{t.projects.kicker}</p>
    <h2 class="proyectos-main-title">{t.projects.title}</h2>
  </div>
  <ProyectosSlider
    client:only="react"
    projects={projects}
    visitLabel={t.projects.visit}
    fallbackTags={t.projects.fallbackTags}
  />
</section>

<style>
  #proyectos {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .projects-heading {
    margin-bottom: 2rem;
  }

  .proyectos-main-title {
    margin-bottom: 0;
  }
</style>
