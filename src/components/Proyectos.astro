---
import { ProyectosSlider } from "../ui/ProyectosSlider";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).map((p) => p.data);
---

<section
  class="container"
  id="proyectos">
  <div class="projects-heading">
    <p class="section-kicker">Portfolio</p>
    <h2 class="proyectos-main-title">Proyectos destacados</h2>
  </div>
  <ProyectosSlider
    client:only="react"
    projects={projects}
  />
</section>

<style>
  #proyectos {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .projects-heading {
    margin-bottom: 2rem;
  }

  .proyectos-main-title {
    margin-bottom: 0;
  }
</style>
