---
import HeroShapes from "../ui/HeroShapes.astro";
---

<section
  class="hero-container container"
  id="home">
  <article class="hero-copy">
    <div class="availability-badge">
      <span class="status-dot"></span>
      Disponible para nuevos proyectos
    </div>

    <h1>
      Hola, soy
      <span>JUAN MARTÍN DE ROSA</span>
    </h1>

    <strong>Desarrollador Web Full Stack & Automatización</strong>

    <p>
      Desarrollo sitios web y aplicaciones modernas. Especializado en crear
      experiencias digitales de alto rendimiento y automatizar flujos de trabajo
      complejos. Especializado en Frontend con React, y Astro. Desarrollo
      aplicaciones web, APIs, integraciones y automatizaciones con Node.js y
      n8n.
    </p>

    <div class="hero-actions">
      <a
        class="button"
        href="#proyectos"
        >Ver proyectos</a
      >
      <a
        class="button button-secondary"
        href="#sobremi"
        >Sobre mi</a
      >
    </div>
  </article>
  <HeroShapes />
</section>

<style>
  .hero-container {
    min-height: calc(100vh - 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: center;
    gap: 4rem;
    padding-top: 5rem;
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-copy strong {
    text-transform: uppercase;
  }
  .availability-badge {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgba(203, 190, 255, 0.32);
    border-radius: 999px;
    background: rgba(109, 84, 207, 0.1);
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  .status-dot {
    width: 0.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--vibrant-accent);
    box-shadow: 0 0 0 0 rgba(163, 137, 255, 0.65);
    animation: pulse 1.8s infinite;
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(2.65rem, 8vw, 5.8rem);
    line-height: 0.96;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h1 span {
    display: block;
    font-family: inherit;
    color: var(--primary);
    text-shadow: 0 0 24px rgba(109, 84, 207, 0.28);
  }

  strong {
    display: block;
    color: var(--white);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  p {
    max-width: 42rem;
    color: var(--on-surface-variant);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-visual {
    min-height: 26rem;
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-visual::before,
  .hero-visual::after,
  .orbit {
    content: "";
    position: absolute;
    border-radius: 999px;
    inset: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit-one {
    width: min(76vw, 23rem);
    aspect-ratio: 1;
    border: 1px dashed rgba(203, 190, 255, 0.28);
    animation: rotate 28s linear infinite;
  }

  .orbit-two {
    width: min(62vw, 18rem);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: radial-gradient(
      circle,
      rgba(109, 84, 207, 0.16),
      transparent 62%
    );
  }

  .hero-visual::before {
    width: min(48vw, 13rem);
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .code-core {
    width: 4.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--primary-container);
    color: var(--white);
    font-family: "JetBrains Mono", monospace;
    font-size: 1.15rem;
    font-weight: 700;
    box-shadow: 0 0 40px rgba(109, 84, 207, 0.35);
    z-index: 2;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.55rem rgba(163, 137, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(163, 137, 255, 0);
    }
  }

  @keyframes rotate {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @media screen and (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2rem;
      padding-top: 4rem;
    }

    .hero-visual {
      min-height: 16rem;
      order: -1;
    }
  }

  @media screen and (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
    }
  }
</style>
