---
import { OpinionSlider } from "../ui/OpinionesSlider";
import { getCollection } from "astro:content";
import type { OpinionData } from "../types/types";

const { t } = Astro.props;
const opinions: OpinionData[] = (await getCollection("opinions")).map(
  (opinion) => ({
    ...opinion,
    data: {
      ...opinion.data,
      opinion: t.opinions.items[opinion.id]?.opinion ?? opinion.data.opinion,
    },
  }),
);
---

<section
  id="opiniones"
  class="container">
  <div class="opinions-heading">
    <p class="section-kicker">{t.opinions.kicker}</p>
    <h2>{t.opinions.title}</h2>
  </div>
  <OpinionSlider
    client:only="react"
    opinions={opinions}
  />
</section>

<style>
  #opiniones {
    text-align: center;
  }

  .opinions-heading {
    margin-bottom: 2rem;
  }

  .opinions-heading h2 {
    margin-bottom: 0;
  }
</style>
