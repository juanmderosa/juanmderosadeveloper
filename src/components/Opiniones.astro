---
import { OpinionSlider } from "../ui/OpinionesSlider";
import { getCollection } from "astro:content";
import type { OpinionData } from "../types/types";

const opinions: OpinionData[] = await getCollection("opinions");
---

<section
  id="opiniones"
  class="container">
  <div class="opinions-heading">
    <p class="section-kicker">Testimonios</p>
    <h2>Opiniones</h2>
  </div>
  <OpinionSlider
    client:only="react"
    opinions={opinions}
  />
</section>

<style>
  #opiniones {
    text-align: center;
  }

  .opinions-heading {
    margin-bottom: 2rem;
  }

  .opinions-heading h2 {
    margin-bottom: 0;
  }
</style>
