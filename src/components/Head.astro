---
import Analytics from "./Analytics.astro";

interface Props {
  title: string;
  description: string;
  locale: "es" | "en";
  alternatePath: string;
  canonicalPath: string;
}

const { title, description, locale, alternatePath, canonicalPath } = Astro.props;
const site = "https://juanmderosa-developer.com";
const alternateLocale = locale === "es" ? "en" : "es";
---

<head>
  <Analytics />
  <meta charset="UTF-8" />
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />
  <meta
    name="description"
    content={description}
  />
  <link
    rel="canonical"
    href={`${site}${canonicalPath}`}
  />
  <link
    rel="alternate"
    hreflang={locale}
    href={`${site}${canonicalPath}`}
  />
  <link
    rel="alternate"
    hreflang={alternateLocale}
    href={`${site}${alternatePath}`}
  />
  <link
    rel="alternate"
    hreflang="x-default"
    href={`${site}/es/`}
  />
  <meta
    property="og:title"
    content={title}
  />
  <meta
    property="og:description"
    content={description}
  />
  <meta
    property="og:locale"
    content={locale === "es" ? "es_AR" : "en_US"}
  />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />
  <link
    rel="shortcut icon"
    href="/favicon.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/favicon.png"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <title>{title}</title>
  <script
    src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_KEY}`}
    async
    defer
  ></script>
</head>
