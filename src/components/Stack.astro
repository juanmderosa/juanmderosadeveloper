---
import { Image } from "astro:assets";
import stackImage from "../assets/images/stackimage.jpg";

const { t } = Astro.props;

const technologies = [
  "HTML",
  "CSS",
  "JavaScript",
  "TypeScript",
  "React",
  "Astro",
  "Next.js",
  "Node.js",
  "Git",
  "Tailwind",
  "WordPress",
  "n8n",
];
---

<section class="container stack-main-container" id="stack">
  <article class="stack-copy">
    <p class="section-kicker">{t.stack.kicker}</p>
    <h2>{t.stack.title}</h2>
    <p>{t.stack.description}</p>

    <ul class="tech-grid" aria-label={t.stack.aria}>
      {
        technologies.map((technology) => (
          <li class="glass-card">
            <span class="tech-icon">{technology.slice(0, 2).toUpperCase()}</span>
            <span class="tech-label">{technology}</span>
          </li>
        ))
      }
    </ul>
  </article>

  <article class="stack-image-wrap" aria-label={t.stack.imageAlt}>
    <div class="image-shadow"></div>
    <Image
      src={stackImage}
      alt={t.stack.imageAlt}
      width={576}
      height={768}
      class="stack-image"
    />
  </article>
</section>

<style>
  .stack-main-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.9fr);
    align-items: center;
    gap: 4rem;
  }

  .stack-copy h2 {
    margin-bottom: 1rem;
  }

  .stack-copy p:not(.section-kicker) {
    max-width: 38rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .tech-grid li {
    min-height: 5.5rem;
    list-style: none;
    display: grid;
    place-items: center;
    gap: 0.45rem;
    padding: 1rem 0.7rem;
    text-align: center;
  }

  .tech-icon {
    width: 2.1rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: rgba(109, 84, 207, 0.16);
    color: var(--primary);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .tech-label {
    color: var(--on-surface);
    font-size: 0.72rem;
  }

  .stack-image-wrap {
    position: relative;
    isolation: isolate;
  }

  .image-shadow {
    position: absolute;
    inset: 1.5rem -1rem -1rem 1.5rem;
    border: 1px solid rgba(203, 190, 255, 0.22);
    border-radius: var(--radius-lg);
    background: rgba(109, 84, 207, 0.16);
    z-index: -1;
  }

  .stack-image {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    filter: saturate(0.85) contrast(1.05);
  }

  @media screen and (max-width: 980px) {
    .stack-main-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media screen and (max-width: 620px) {
    .tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
