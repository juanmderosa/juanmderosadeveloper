---
import Circles from "./Circles.astro";
import BigCircle from "./BigCircle.astro";
---

<aside class="heroshapes-container">
  <div class="orbit-layer orbit-layer-front">
    <BigCircle
      width="250px"
      top="0%"
      left="-20%"
      background="repeating-linear-gradient(-45deg, var(--silver), var(--silver) 10px, transparent 10px, transparent 20px)"
      zindex="1"
    />
  </div>

  <div class="core-circle">
    <BigCircle
      width="250px"
      top="-200px"
      left="100px"
      background="var(--purple)"
      zindex="3"
    />
  </div>

  <div class="orbit-layer orbit-layer-back">
    <BigCircle
      width="300px"
      top="0"
      left="0"
      background="repeating-linear-gradient(45deg, var(--silver), var(--silver) 10px, transparent 10px, transparent 20px)"
      zindex="0"
    />
  </div>
  <Circles />
</aside>

<style>
  .heroshapes-container {
    grid-column: 2/3;
    grid-row: 1/3;
    position: relative;
    isolation: isolate;
  }

  .orbit-layer,
  .core-circle {
    position: absolute;
    inset: 0;
    transform-origin: center /* calc(10% + 125px) calc(15% + 125px) */;
    will-change: transform, opacity, filter;
  }

  .orbit-layer-front {
    z-index: 2;
    animation: orbit-spin-clockwise 18s linear infinite;
  }

  .orbit-layer-back {
    z-index: 1;
    animation: orbit-spin-counter 24s linear infinite;
  }

  .core-circle {
    z-index: 4;
    animation: pulseCore 6s linear infinite;
  }

  .orbit-layer :global(.bigCircle) {
    opacity: 0;
    transform: scale(0.94);
    animation: orbit-circle-enter 900ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .orbit-layer-back :global(.bigCircle) {
    animation-delay: 160ms;
  }

  .heroshapes-container :global(.circles-container) {
    z-index: 0;
  }

  @keyframes pulseCore {
    0% {
      opacity: 100%;
      transform: scale(1);
    }

    50% {
      opacity: 90%;
      transform: scale(0.9);
    }

    100% {
      opacity: 100%;
      transform: scale(1);
    }
  }

  @keyframes orbit-circle-enter {
    0% {
      opacity: 0;
      transform: scale(0.9);
      filter: blur(2px);
    }

    100% {
      opacity: 1;
      transform: rotate(0deg) scale(1);
      filter: blur(0);
    }
  }

  @keyframes orbit-spin-clockwise {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-spin-counter {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(-360deg);
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1023px) {
    .heroshapes-container {
      display: none;
    }
  }
</style>
