---
const { t } = Astro.props;
---

<nav
  class="site-nav"
  aria-label={t.nav.aria}>
  <a
    class="brand"
    href="#home"
    aria-label={t.nav.homeAria}>
    {t.nav.brand}
  </a>

  <input
    type="checkbox"
    name="mobile-nav"
    id="mobile-nav"
    class="nav-toggle"
    aria-label="Abrir navegación"
  />
  <label
    class="nav-toggle-label"
    for="mobile-nav"
    aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <div class="nav-links">
    <a href="#sobremi">{t.nav.about}</a>
    <a href="#stack">{t.nav.stack}</a>
    <a href="#experiencia">{t.nav.experience}</a>
    <a href="#proyectos">{t.nav.projects}</a>
    <a
      href="#contactame"
      id="contactameNav"
      >{t.nav.contact}</a
    >
  </div>

  <a
    class="nav-cta button"
    href="#contactame"
    >{t.nav.cta}</a
  >
  <a
    class="lang-link"
    href={t.alternatePath}
    aria-label={t.alternateLabel}
    >{t.alternateLabel}</a
  >
</nav>

<style>
  .site-nav {
    position: relative;
    width: min(calc(100% - 2rem), var(--container-max-width));
    margin: 0 auto;
    min-height: 4rem;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0.8rem;
  }

  .brand {
    font-family: "Montserrat", sans-serif;
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.6rem);
  }

  .nav-links a,
  .nav-cta {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    color: var(--on-surface-variant);
    transition: color 300ms ease;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  .nav-cta {
    min-height: 2.25rem;
    padding: 0.65rem 1rem;
    color: var(--white);
    white-space: nowrap;
  }

  #contactameNav {
    display: none;
  }

  .lang-link {
    min-width: 2.6rem;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(151, 125, 255, 0.48);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(109, 84, 207, 0.24), rgba(255, 255, 255, 0.06)),
      rgba(18, 20, 20, 0.72);
    box-shadow: 0 0 24px rgba(109, 84, 207, 0.22);
    color: var(--white);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
    transition:
      border-color 250ms ease,
      box-shadow 250ms ease,
      transform 250ms ease;
  }

  .lang-link:hover {
    border-color: rgba(177, 156, 255, 0.9);
    box-shadow: 0 0 32px rgba(109, 84, 207, 0.34);
    transform: translateY(-1px);
  }

  .nav-toggle,
  .nav-toggle-label {
    display: none;
  }

  @media screen and (max-width: 840px) {
    .site-nav {
      grid-template-columns: 1fr auto auto;
      min-height: 3.75rem;
      gap: 0.65rem;
    }

    .nav-toggle-label {
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.65rem;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.04);
    }

    .nav-toggle-label span {
      width: 100%;
      height: 2px;
      border-radius: 999px;
      background: var(--on-surface);
    }

    .nav-links,
    .nav-cta {
      display: none;
    }

    .lang-link {
      grid-column: 2;
      grid-row: 1;
      min-width: 2.55rem;
      min-height: 2.5rem;
    }

    .nav-toggle-label {
      grid-column: 3;
      grid-row: 1;
    }

    #contactameNav {
      display: block;
    }

    .nav-toggle:checked ~ .nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      z-index: 1000;
      display: grid;
      gap: 0.25rem;
      justify-items: stretch;
      padding: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-md);
      background: rgba(18, 20, 20);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.34);
      backdrop-filter: blur(18px);
    }

    .nav-toggle:checked ~ .nav-links a {
      padding: 0.7rem;
      border-radius: var(--radius);
    }

    .nav-toggle:checked ~ .nav-links a:hover {
      background: rgba(109, 84, 207, 0.16);
    }
  }
</style>

<script>
  const siteNav = document.querySelector(".site-nav");
  const navToggle = document.getElementById("mobile-nav") as HTMLInputElement | null;
  const navLinks = document.querySelectorAll(".nav-links a");

  function closeMobileNav() {
    if (navToggle) navToggle.checked = false;
  }

  navLinks.forEach((link) => {
    link.addEventListener("click", closeMobileNav);
  });

  document.addEventListener("click", (event) => {
    if (!navToggle?.checked) return;
    if (siteNav?.contains(event.target as Node)) return;

    closeMobileNav();
  });
</script>
