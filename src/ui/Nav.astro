<nav
  class="site-nav"
  aria-label="Principal">
  <a
    class="brand"
    href="#home"
    aria-label="Ir al inicio">
    Juan Martín De Rosa
  </a>

  <input
    type="checkbox"
    name="mobile-nav"
    id="mobile-nav"
    class="nav-toggle"
    aria-label="Abrir navegación"
  />
  <label
    class="nav-toggle-label"
    for="mobile-nav"
    aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <div class="nav-links">
    <a href="#sobremi">Sobre mi</a>
    <a href="#stack">Stack</a>
    <a href="#experiencia">Experiencia</a>
    <a href="#proyectos">Projectos</a>
    <a
      href="#contactame"
      id="contactameNav"
      >Contacto</a
    >
  </div>

  <a
    class="nav-cta button"
    href="#contactame"
    >Contactarme</a
  >
</nav>

<style>
  .site-nav {
    position: relative;
    width: min(calc(100% - 2rem), var(--container-max-width));
    margin: 0 auto;
    min-height: 4rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    font-family: "Montserrat", sans-serif;
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.6rem);
  }

  .nav-links a,
  .nav-cta {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    color: var(--on-surface-variant);
    transition: color 300ms ease;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  .nav-cta {
    min-height: 2.25rem;
    padding: 0.65rem 1rem;
    color: var(--white);
    white-space: nowrap;
  }

  #contactameNav {
    display: none;
  }
  .nav-toggle,
  .nav-toggle-label {
    display: none;
  }

  @media screen and (max-width: 840px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      min-height: 3.75rem;
    }

    .nav-toggle-label {
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.65rem;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.04);
    }

    .nav-toggle-label span {
      width: 100%;
      height: 2px;
      border-radius: 999px;
      background: var(--on-surface);
    }

    .nav-links,
    .nav-cta {
      display: none;
    }

    #contactameNav {
      display: block;
    }

    .nav-toggle:checked ~ .nav-links {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      z-index: 1000;
      display: grid;
      gap: 0.25rem;
      justify-items: stretch;
      padding: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-md);
      background: rgba(18, 20, 20);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.34);
      backdrop-filter: blur(18px);
    }

    .nav-toggle:checked ~ .nav-links a {
      padding: 0.7rem;
      border-radius: var(--radius);
    }

    .nav-toggle:checked ~ .nav-links a:hover {
      background: rgba(109, 84, 207, 0.16);
    }
  }
</style>

<script>
  const siteNav = document.querySelector(".site-nav");
  const navToggle = document.getElementById("mobile-nav") as HTMLInputElement | null;
  const navLinks = document.querySelectorAll(".nav-links a");

  function closeMobileNav() {
    if (navToggle) navToggle.checked = false;
  }

  navLinks.forEach((link) => {
    link.addEventListener("click", closeMobileNav);
  });

  document.addEventListener("click", (event) => {
    if (!navToggle?.checked) return;
    if (siteNav?.contains(event.target as Node)) return;

    closeMobileNav();
  });
</script>
