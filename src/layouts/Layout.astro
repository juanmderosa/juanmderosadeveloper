---
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import WhatsappButton from "../ui/WhatsappButton.astro";
---

<!doctype html>
<html lang="es">
  <Head title="Juanmderosa Developer" />
  <body>
    <Header />
    <slot />
    <Footer />
    <WhatsappButton />
  </body>
</html>

<style is:global>
  html {
    overflow-x: hidden;
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  :root {
    --background-deep: #0f0e17;
    --surface: #121414;
    --surface-container-low: #1a1c1c;
    --surface-container: #1e2020;
    --surface-container-high: #292a2a;
    --surface-glass: rgba(38, 37, 51, 0.6);
    --on-surface: #e3e2e2;
    --on-surface-variant: #cac4d5;
    --outline: #938e9f;
    --outline-variant: #484553;
    --primary: #cbbeff;
    --primary-container: #6d54cf;
    --vibrant-accent: #a389ff;
    --white: #ffffff;
    --error: #ffb4ab;
    --container-max-width: 1280px;
    --gutter: 2rem;
    --section-gap: 7.5rem;
    --radius-sm: 0.25rem;
    --radius: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --ghost-white: var(--on-surface);
    --silver: var(--on-surface-variant);
    --french-gray: var(--outline);
    --raisin-black: var(--surface);
    --non-photo-blue: var(--primary);
    --purple: var(--primary-container);
  }

  html {
    background: var(--background-deep);
    color: var(--on-surface);
  }

  body {
    width: 100%;
    min-height: 100vh;
    background:
      radial-gradient(
        circle at 80% 8%,
        rgba(109, 84, 207, 0.18),
        transparent 28rem
      ),
      radial-gradient(
        circle at 10% 28%,
        rgba(38, 37, 51, 0.75),
        transparent 24rem
      ),
      linear-gradient(
        180deg,
        var(--background-deep) 0%,
        var(--surface) 48%,
        #0d0e0f 100%
      );
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    color: var(--on-surface);
  }

  p,
  span,
  strong,
  li,
  input,
  textarea,
  label,
  a {
    font-family: "Hanken Grotesk", sans-serif;
    text-decoration: none;
  }

  p,
  span,
  strong,
  li,
  label {
    color: var(--on-surface-variant);
  }

  p {
    font-size: 1rem;
    line-height: 1.65;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    color: var(--on-surface);
    letter-spacing: 0;
  }

  a {
    color: inherit;
  }

  .button {
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    color: var(--white);
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--primary-container);
    min-height: 2.75rem;
    padding: 0.8rem 1.2rem;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    transition:
      transform 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease;
    font-size: 0.85rem;
    line-height: 1;
  }

  .button:hover {
    background: #7b63dd;
    transform: translateY(-2px);
  }

  .button.button-secondary {
    background: transparent;
    border-color: var(--primary-container);
    color: var(--primary);
  }

  .button.button-secondary:hover {
    background: rgba(109, 84, 207, 0.18);
  }

  .container {
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--section-gap) var(--gutter);
    overflow: visible;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  h3 {
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.2;
  }

  .section-kicker,
  .chip,
  .tech-label {
    font-family: "JetBrains Mono", monospace;
  }

  .section-kicker {
    color: var(--primary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .glass-card {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 30%),
      var(--surface-glass);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(16px);
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .glass-card:hover {
    border-color: rgba(203, 190, 255, 0.45);
    box-shadow: 0 8px 32px rgba(109, 84, 207, 0.2);
    transform: translateY(-2px);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(109, 84, 207, 0.35);
    border-radius: 9999px;
    background: rgba(109, 84, 207, 0.12);
    color: var(--primary);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.38rem 0.6rem;
  }

  .oculto {
    opacity: 1;
  }

  .mostrar {
    opacity: 1;
  }

  .grecaptcha-badge {
    display: none !important;
  }

  @media screen and (max-width: 768px) {
    :root {
      --gutter: 1rem;
      --section-gap: 4rem;
    }
    .container {
      padding-block: var(--section-gap);
    }

    .button {
      width: 100%;
    }

    h2 {
      margin-bottom: 1.5rem;
    }
  }
</style>

<!-- Intersection observer script removed from layout to disable automatic reveal. File kept at src/services/intersectionObserver.js -->
